---
import { languages } from "@i18n/ui";
import {
  getLangFromUrl,
  useTranslatedPath,
  useTranslations,
} from "@i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<nav aria-label={t("a11y.languageSwitcher")} class="flex items-center">
  <ul class="m-0 flex list-none items-center gap-1 p-0">
    {
      Object.keys(languages).map((langPrefix) => (
        <li>
          <a
            href={translatePath("/", langPrefix)}
            aria-current={langPrefix === lang ? "true" : undefined}
            class:list={[
              "inline-flex items-center rounded-full px-3 py-1.5 text-[12px] font-semibold uppercase tracking-wide no-underline transition-colors duration-200",
              langPrefix === lang
                ? "bg-accent text-white"
                : "text-ink/70 hover:bg-surface-2 hover:text-ink",
            ]}
          >
            {langPrefix}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
