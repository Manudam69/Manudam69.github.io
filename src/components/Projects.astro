---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Skills from "./Skills.astro";
import { getLangFromUrl, useTranslations } from "@i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/images/*.{jpeg,jpg,png,gif}"
);
const {
  title,
  url,
  picture_url,
  href,
  technologies,
  featured = false,
} = Astro.props;

if (!images[picture_url])
  throw new Error(
    `"${picture_url}" does not exist in glob: "src/assets/*.{jpeg,jpg,png,gif}"`
  );

interface Props {
  title: string;
  url: string;
  href: string;
  picture_url: string;
  technologies: Array<string>;
  featured?: boolean;
}
---

<article
  class:list={[
    "card card-hover group relative flex h-full flex-col",
    featured && "laptop:col-span-2 tablet:flex-row tablet:items-stretch tablet:gap-8",
  ]}
>
  <a
    href={href}
    target="_blank"
    rel="noopener noreferrer"
    class="absolute inset-0 z-10 rounded-card"
    aria-label={`${t("projects.viewProject")}: ${title}`}
  >
  </a>
  <div
    class:list={[
      "aspect-video w-full shrink-0 overflow-hidden rounded-[10px] border border-line/15",
      featured ? "tablet:aspect-auto tablet:h-full tablet:w-1/2" : "",
    ]}
  >
    <Image
      src={images[picture_url]()}
      alt=""
      class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.04]"
    />
  </div>
  <div
    class:list={[
      "mt-5 flex flex-1 flex-col",
      featured ? "tablet:mt-0" : "",
    ]}
  >
    <div class="flex items-center justify-between gap-3">
      <h3>{title}</h3>
      <span
        aria-hidden="true"
        class="shrink-0 text-muted transition-transform duration-200 group-hover:-translate-y-0.5 group-hover:translate-x-0.5"
        >↗</span
      >
    </div>
    <p class="mt-1 text-[13px] font-semibold text-accent">{url}</p>
    <p class="sr-only">{t("projects.description")}</p>
    <p class="mt-3 text-[14px] leading-[150%] text-muted">
      <slot />
    </p>
    <div class="mt-5 flex flex-wrap gap-2">
      <span class="sr-only">{t("projects.technologies")}: </span>
      {technologies.map((technology) => <Skills>{technology}</Skills>)}
    </div>
  </div>
</article>

