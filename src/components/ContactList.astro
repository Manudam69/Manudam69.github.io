---
import { Image } from "astro:assets";

interface Props {
  src: string;
  alt: string;
  href: string;
  target?: string;
  iconOnly?: boolean;
}

const { src, alt, href, target = "_self", iconOnly = false } = Astro.props;
const rel = target === "_blank" ? "noopener noreferrer" : undefined;
---

{
  iconOnly ? (
    <a class="icon-link" href={href} target={target} rel={rel} aria-label={alt}>
      <Image src={src} width={18} height={18} alt="" class="h-[18px] w-[18px] invert" />
    </a>
  ) : (
    <a
      class="flex w-fit items-center gap-3 no-underline text-ink hover:text-accent"
      href={href}
      target={target}
      rel={rel}
    >
      <Image
        src={src}
        width={18}
        height={18}
        alt=""
        class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-line/25 bg-surface-2 p-2 invert"
      />
      <span class="font-medium text-ink">
        <slot />
      </span>
    </a>
  )
}
