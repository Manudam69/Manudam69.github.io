---
import { getLangFromUrl, useTranslations } from "@i18n/utils";

interface Props {
  position: string;
  company: string;
  place: string;
  date: string;
  stillWorkingThere?: boolean;
  tasks?: Array<string>;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const {
  position,
  company,
  place,
  date,
  stillWorkingThere = false,
  tasks = [],
} = Astro.props;
---

<div class="relative pl-8 tablet:pl-10">
  <span
    class="absolute left-0 top-2 h-2.5 w-2.5 -translate-x-1/2 rounded-full bg-accent"
    aria-hidden="true"
  >
  </span>
  <span
    class="absolute left-0 top-2 h-full w-px -translate-x-1/2 bg-line/20"
    aria-hidden="true"
  >
  </span>
  <div class="pb-10">
    <div class="flex flex-wrap items-baseline justify-between gap-2">
      <h3 class="text-ink">{position}</h3>
      <span class="shrink-0 text-[13px] font-medium text-muted">
        {date}{stillWorkingThere ? ` — ${t("experience.present")}` : ""}
      </span>
    </div>
    <p class="mt-1 text-[15px] font-semibold text-accent">
      {company}
    </p>
    {place && <p class="mt-0.5 text-[13px] text-muted">{place}</p>}
    {
      tasks.length > 0 && (
        <ul class="mt-4 space-y-2.5">
          {tasks.map((task) => (
            <li class="flex gap-2.5 text-[14px] leading-[150%] text-muted">
              <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-line" aria-hidden="true" />
              <span>{task}</span>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</div>

