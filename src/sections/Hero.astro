---
import { Image } from "astro:assets";
import ProfileImage from "@assets/images/foto_perfil.jpg";
import ContactList from "@components/ContactList.astro";
import { getLangFromUrl, useTranslations } from "@i18n/utils";
import { getContactList } from "@data/contact";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const contactList = getContactList(t);
---

<section
  id="home"
  class="section section-pad !pt-10"
  aria-labelledby="home-heading"
>
  <div class="grid items-center gap-12 tablet:grid-cols-[1.05fr_0.95fr] laptop:gap-16">
    <div>
      <p class="eyebrow mb-4">{t("hero.greeting")}</p>
      <h1 id="home-heading" class="text-balance">Manuel David Alonso Muñoz</h1>
      <p class="mt-4 text-[18px] font-semibold text-ink laptop:text-[22px]">
        {t("hero.role")}
      </p>
      <p class="mt-5 max-w-[58ch] text-muted">
        {t("header.description")}
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-4">
        <a href="#projects" class="btn-primary">{t("hero.ctaProjects")}</a>
        <a href="#contact" class="btn-secondary">{t("hero.ctaContact")}</a>
      </div>

      <div class="mt-10">
        <span class="section-label">{t("hero.quickContact")}</span>
        <ul class="m-0 mt-3 flex list-none flex-wrap gap-3 p-0">
          {
            contactList.map((contact) => (
              <li>
                <ContactList
                  iconOnly
                  src={contact.src}
                  alt={contact.alt}
                  href={contact.href}
                  target={contact.target}
                >
                  {contact.children}
                </ContactList>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="relative mx-auto w-full max-w-[280px] tablet:max-w-none">
      <div
        class="absolute inset-0 -z-10 scale-95 rounded-card bg-accent/20 blur-3xl"
        aria-hidden="true"
      >
      </div>
      <Image
        src={ProfileImage}
        alt="Manuel David Alonso Muñoz"
        class="aspect-[4/5] w-full rounded-card border border-line/15 object-cover shadow-elevated"
      />
    </div>
  </div>
</section>
