---
import Expirence from "@components/Expirence.astro";
import { getLangFromUrl, useTranslations } from "@i18n/utils";
import { getI18N } from "@i18n/index";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale });
const experiences = i18n.EXPERIENCES;
---

<section id="experience" class="section section-pad" aria-labelledby="experience-heading">
  <h2 id="experience-heading">{t("experience.experience")}</h2>
  <div class="mt-10 max-w-[760px]">
    {
      experiences.map((experience) => (
        <Expirence
          position={experience.position}
          company={experience.company}
          place={experience.place}
          date={experience.date}
          stillWorkingThere={experience.stillWorkingThere}
          tasks={experience.tasks}
        />
      ))
    }
  </div>
</section>

